{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Profiler Tool",
  "version": "2.1.0",
  "identifier": "com.lolprofilertool.app",
  "mainBinaryName": "LoLProfilerTool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoL Profiler Tool",
        "width": 1080,
        "height": 920,
        "resizable": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "LoL Profiler Tool",
    "shortDescription": "Customize your League of Legends profile from the desktop.",
    "longDescription": "A desktop tool to customize League of Legends status, rank, banners, badges, and more.",
    "copyright": "Copyright © 2026 David William",
    "homepage": "https://github.com/sluucke/lol-profiler-tool",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sluucke/lol-profiler-tool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzODQ1MUNDRjQ5QUEzNTkKUldSWm81cjB6RkdFNDY4bGdUbVQ5K2RpL1NYU0owS3VZN1JtZGE4bFNVK2ZCcXBIaG1FdDEvTTIK"
    }
  }
}
